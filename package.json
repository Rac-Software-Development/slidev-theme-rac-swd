{
  "name": "slidev-theme-rac-swd",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.16.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.16.0",
    "vue": "^3.5.40"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "Poppins",
        "mono": "JetBrains Mono"
      }
    }
  },
  "peerDependencies": {
    "vue": "^3.5.40"
  }
}
